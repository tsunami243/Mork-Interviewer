LLM_MODEL=your-model-name
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://your-model-provider.example/v1
LLM_THINKING_MODE=disabled
DASHSCOPE_API_KEY=replace-with-your-bailian-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Wiki执行预算（新建任务默认；已建任务需在执行记录中明确增加预算）
WIKI_MAX_MODEL_CALLS=64
WIKI_MAX_TOKENS=100000
WIKI_MAX_ACTIVE_SECONDS=600
WIKI_MAX_PAGES=24
WIKI_CONCURRENCY=3
WIKI_REQUEST_ATTEMPTS=2
